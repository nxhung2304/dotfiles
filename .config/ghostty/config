title = " "

# Font configuration
font-family = Maple Mono NF
font-family = JetBrains Mono
font-size = 15

# Line height (spacing between lines)
adjust-cell-height = 15%

# Theme
config-file = ?theme

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
adjust-cursor-thickness = 2

# Window và UI enhancements
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true
window-padding-color = extend
window-decoration = true
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-title-font-family = JetBrains Mono
window-save-state = always
window-step-resize = true

# Transparency và blur effects (macOS)
background-opacity = 1
background-blur-radius = 24

# Font rendering improvements
font-feature = +liga
font-feature = +calt
font-thicken = true

# Performance và animation
auto-update = check
unfocused-split-opacity = 0.7
resize-overlay = never

# Scrollback và history (value in bytes; ~100 MB)
scrollback-limit = 100000000
scrollbar = never
mouse-hide-while-typing = true

# Tab bar styling (nếu dùng tabs)
gtk-tabs-location = top
macos-non-native-fullscreen = true

# Copy/paste improvements
copy-on-select = clipboard
click-repeat-interval = 500
confirm-close-surface = false

# Shell integration
# shell-integration = zsh
# shell-integration-features = cursor,sudo,title
shell-integration-features = no-title

# === KEYBINDS ===
# Font size control
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Search functionality
# keybind = cmd+f=search
# keybind = cmd+g=search_next
# keybind = cmd+shift+g=search_previous
# keybind = escape=search_cancel

# Copy/paste
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Clear screen
keybind = cmd+k=clear_screen

# Basic window management
keybind = cmd+w=close_surface
keybind = cmd+q=quit
