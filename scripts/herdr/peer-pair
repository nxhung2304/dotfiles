#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/popup-context.sh"
source "$SCRIPT_DIR/../herdr-sessionizer"

current_repo_dir() {
    local pane_cwd
    pane_cwd=$(herdr pane current --current | jq -r '.result.pane.cwd')
    git -C "$pane_cwd" rev-parse --show-toplevel 2>/dev/null || echo "$pane_cwd"
}

peer_candidates() {
    local current_dir=$1
    {
        recent_repo_dirs
        find "${project_roots[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort
    } | awk -v current="$current_dir" '
        { is_current = $0 == current; is_duplicate = seen[$0]++ }
        !is_current && !is_duplicate'
}

workspace_has_agent() {
    local workspace_id=$1
    herdr agent list | jq -e --arg id "$workspace_id" 'any(.result.agents[]; .workspace_id == $id)' >/dev/null
}

start_named_claude() {
    local pane_id=$1
    local session_name=$2
    herdr pane send-text "$pane_id" "claude -n $(printf '%q' "$session_name")" >/dev/null
    herdr pane send-keys "$pane_id" enter >/dev/null
}

open_peer() {
    local peer_dir=$1
    local session_name existing_id created root_pane

    session_name=$(basename "$peer_dir")
    existing_id=$(open_workspace_id_for_path "$peer_dir")
    if [[ -n $existing_id ]]; then
        herdr workspace focus "$existing_id" >/dev/null
        workspace_has_agent "$existing_id" ||
            pause_with_hint "No Claude in $session_name yet: run 'claude -n $session_name' there."

        return 0
    fi

    zoxide add "$peer_dir"

    created=$(herdr workspace create --cwd "$peer_dir" --label "$session_name" --focus)
    root_pane=$(jq -r '.result.root_pane.pane_id' <<<"$created")

    start_named_claude "$root_pane" "$session_name"
}

pause_with_hint() {
    echo "$1"
    read -r -p "press enter to close" _
}

current_dir=$(current_repo_dir)
peer_dir=$(peer_candidates "$current_dir" | pick "pair $(basename "$current_dir") with" --tiebreak=index) || exit 0
[[ -n $peer_dir ]] || exit 0

open_peer "$peer_dir"
