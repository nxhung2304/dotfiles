#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly PORT=${BOARD_PORT:-4777}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "board: run inside a git repository" >&2
    exit 1
}

if [[ ! -d $repo_root/specs/issues ]]; then
    echo "board: $repo_root has no specs/issues folder" >&2
    exit 1
fi

if [[ -z ${HERDR_ENV:-} ]]; then
    echo "board: not inside herdr, starting tasks from the board will not work" >&2
fi

if [[ ${1:-} != --no-open ]] && command -v open >/dev/null; then
    (sleep 1 && open "http://127.0.0.1:$PORT") &
fi

BOARD_PORT=$PORT exec node "$SCRIPT_DIR/server.js" "$repo_root"
