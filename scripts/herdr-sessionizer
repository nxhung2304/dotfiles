#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~ ~/Dev/personal ~/Dev/rights -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z ${selected:-} ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

existing=$(herdr workspace list | jq -r --arg name "$selected_name" \
    '.result.workspaces[] | select(.label == $name) | .workspace_id' | head -1)

if [[ -n $existing ]]; then
    herdr workspace focus "$existing" >/dev/null
    exit 0
fi

created=$(herdr workspace create --cwd "$selected" --label "$selected_name" --focus)
root_pane=$(echo "$created" | jq -r '.result.root_pane.pane_id')

for hydrate_file in "$selected/.tmux-sessionizer" "$HOME/.tmux-sessionizer"; do
    if [[ -f $hydrate_file ]]; then
        herdr pane send-text "$root_pane" "source $hydrate_file" >/dev/null
        herdr pane send-keys "$root_pane" enter >/dev/null
        break
    fi
done
